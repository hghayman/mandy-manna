const defaultIcon = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`;

const categories: {
  id: string;
  label: string;
  color: CategoryColor;
  description: string;
  programs: { title: string; description: string; image: ImageMetadata }[];
}[] = [
  {
    id: "education",
    label: "Education",
    color: "green",
    description: "Hands-on agricultural learning from kindergarten through 12th grade, connecting classrooms to the real world of the farm.",
    programs: [
      {
        title: "On-Farm Learning Experiences",
        description: "Hands-on agricultural programming for K-12 students across the School District of Philadelphia, connecting classroom learning to real-world farm systems.",
        image: imgOnFarm,
      },
      {
        title: "Traveling Outreach Program",
        description: "Mobile agricultural education bringing Fox Chase Farm programming directly to schools and community sites throughout Philadelphia.",
        image: imgAmbassadors,
      },
      {
        title: "Ag Empowerment Programs",
        description: "Inclusive programming designed for students with diverse learning needs, connecting them to agricultural experiences that build confidence and real-world skills.",
        image: imgEmpowerment,
      },
      {
        title: "Jr. MANRRS Leadership",
        description: "Minorities in Agriculture, Natural Resources and Related Sciences student chapter providing leadership development and professional networking opportunities.",
        image: imgAnimalScience,
      },
    ],
  },
  {
    id: "workforce",
    label: "Workforce Development",
    color: "teal",
    description: "Career-connected pathways from pre-apprenticeship to professional certification, preparing students for the agricultural economy of tomorrow.",
    programs: [
      {
        title: "CEA Pre-Apprenticeship Program",
        description: "Philadelphia's first district-wide Controlled Environment Agriculture pre-apprenticeship pipeline, active at Mastbaum HS, Overbrook HS, and Martin Luther King HS.",
        image: imgFieldWork,
      },
      {
        title: "Agriculture Innovations Academy",
        description: "In partnership with the University of Utah, this academy certifies Philadelphia educators in agricultural literacy, targeting 180+ teachers.",
        image: imgAcademy,
      },
      {
        title: "Student-Run Enterprises",
        description: "Real-world business experience through the Fox Chase Farm Store, district-wide markets, and Maple Leaf Café, managed by students from farm to sale.",
        image: imgEnterprise,
      },
      {
        title: "Skilled Trades Pathways",
        description: "Pre-apprenticeships in plumbing and electrical trades integrated with agricultural programming to build comprehensive workforce readiness.",
        image: imgEnterprise2,
      },
    ],
  },
  {
    id: "community",
    label: "Community",
    color: "emerald",
    description: "Open programming that welcomes Philadelphia families and neighbors, creating shared connections to land, food, and each other.",
    programs: [
      {
        title: "ESY Horticulture Program",
        description: "Extended School Year horticulture programming providing meaningful summer learning for students with Individualized Education Programs.",
        image: imgBirdhouse,
      },
      {
        title: "Weekend Family Experiences",
        description: "Open farm events connecting Philadelphia families to agricultural education, seasonal programming, and community building throughout the year.",
        image: imgMarket,
      },
      {
        title: "Signature Community Events",
        description: "Annual events including Ag Discovery Day, Rooster Run, Cow Plop Bingo, Baby Goat Naming, and Bird Walks, engaging thousands of community members.",
        image: imgFarmShow,
      },
      {
        title: "GAIN Media Network",
        description: "Global Agriculture Innovation Network delivering agriculture innovation content to teachers and students, expanding the reach of Fox Chase Farm's programming.",
        image: imgMandyStudents,
      },
    ],
  },
];
---

<Base
  title="Programs - Fox Chase Farm"
  meta_title="Programs - Dr. Mandy Manna & Fox Chase Farm"
  description="Explore agricultural education, workforce development, and community programs at Fox Chase Farm, serving 62K+ students annually across 60 Philadelphia schools."
>
  <!-- Page Header -->
  <section class="pt-20 pb-12 text-center" style="background-color: #fafaf8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span
        class="inline-block text-xs font-semibold tracking-widest uppercase mb-4 px-3 py-1.5 rounded-full"
        style="background-color: #e8f0eb; color: #2d5a3d;"
      >
        Fox Chase Farm
      </span>
      <h1
        class="text-4xl lg:text-5xl font-serif font-semibold mb-5 leading-tight"
        style="color: #1a2e1e;"
      >
        Programs at Fox Chase Farm
      </h1>
      <p class="text-lg max-w-2xl mx-auto mb-8" style="color: #5a7060;">
        Agricultural education, workforce development, and community engagement serving 62K+ students across Philadelphia every year.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="#education"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Education
        </a>
        <a
          href="#workforce"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Workforce Development
        </a>
        <a
          href="#community"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Community
        </a>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="py-12" style="background-color: #f0f4f1;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span
          class="inline-block text-xs font-semibold tracking-widest uppercase mb-3 px-3 py-1.5 rounded-full"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          In Action
        </span>
        <h2 class="text-2xl font-serif font-semibold" style="color: #1a2e1e;">
          See the Programs in Action
        </h2>
      </div>
      <div
        id="video-container"
        class="relative rounded-2xl overflow-hidden cursor-pointer shadow-xl"
        style="background-color: #0d1f13;"
      >
        <video
          id="hero-video"
          muted
          loop
          playsinline
          class="w-full block"
          style="max-height: 480px; display: block;"
          poster={imgMandyStudents.src}
        >
          <source src="/videos/cte-programs-trimmed.mp4" type="video/mp4" />
        </video>
        <!-- Play overlay: visible when paused -->
        <div
          id="video-overlay"
          class="absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-300"
          style="background: rgba(13,31,19,0.45);"
        >
          <div
            class="w-20 h-20 rounded-full flex items-center justify-center mb-3 shadow-lg"
            style="background: rgba(255,255,255,0.92);"
          >
            <svg class="w-8 h-8" style="color: #1a3325; margin-left: 4px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
          <p class="text-white text-sm font-medium tracking-wide opacity-80">Hover to play</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section style="background-color: #fafaf8; border-bottom: 1px solid #dde8de;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-wrap justify-center gap-8 lg:gap-16">
        <div class="text-center">
          <div class="text-2xl font-serif font-semibold" style="color: #1a3325;">62K+</div>
          <div class="text-xs font-medium tracking-wide uppercase mt-0.5" style="color: #6b7f70;">Students Annually</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-serif font-semibold" style="color: #1a3325;">60</div>
          <div class="text-xs font-medium tracking-wide uppercase mt-0.5" style="color: #6b7f70;">Schools Served</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-serif font-semibold" style="color: #1a3325;">180+</div>
          <div class="text-xs font-medium tracking-wide uppercase mt-0.5" style="color: #6b7f70;">Teachers Engaged</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-serif font-semibold" style="color: #1a3325;">112</div>
          <div class="text-xs font-medium tracking-wide uppercase mt-0.5" style="color: #6b7f70;">Acres of Farm</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Program Categories -->
  {
    categories.map((cat) => {
      const c = colorStyles[cat.color];
      return (
        <section class="py-16" style={c.bg} id={cat.id}>
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            {/* Category header */}
            <div class="flex items-center gap-4 mb-2">
              <span
                class="px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase"
                style={c.badge}
              >
                {cat.label}
              </span>
              <div class="flex-1 h-px" style="background-color: #dde8de;"></div>
            </div>
            <p class="text-base mb-10" style="color: #5a7060;">{cat.description}</p>

            {/* Program cards */}
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {cat.programs.map((program) => {
                  const iconPath = programIcons[program.title] ?? defaultIcon;
                  return (
                    <div
                      class="bg-white rounded-xl overflow-hidden transition-all duration-300 hover:shadow-md flex flex-col"
                      style="border: 1px solid #dde8de;"
                    >
                      <div class="h-36 overflow-hidden">
                        <Image
                          src={program.image}
                          alt={program.title}
                          width={400}
                          height={144}
                          format="webp"
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <div class="p-5 flex flex-col flex-1">
                        <div
                          class="w-8 h-8 rounded-lg flex items-center justify-center mb-3 flex-shrink-0"
                          style={c.iconBg}
                        >
                          <svg
                            class="w-4 h-4 text-white"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            set:html={iconPath}
                          />
                        </div>
                        <h3
                          class="text-sm font-semibold mb-1.5 leading-snug"
                          style="color: #1a2e1e;"
                        >
                          {program.title}
                        </h3>
                        <p
                          class="text-xs leading-relaxed flex-1"
                          style="color: #6b7f70;"
                        >
                          {program.description}
                        </p>
                      </div>
                    </div>
                  );
                })}
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- Infrastructure Placeholder -->
  <section class="py-16" style="background-color: #ffffff;" id="infrastructure">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span
          class="px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase"
          style="background-color: #f0f4f1; color: #5a7060;"
        >
          Infrastructure
        </span>
        <div class="flex-1 h-px" style="background-color: #dde8de;"></div>
      </div>
      <div class="rounded-2xl p-12 text-center" style="border: 2px dashed #dde8de;">
        <div
          class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6"
          style="background-color: #f0f4f1;"
        >
          <svg
            class="w-8 h-8"
            style="color: #6b7f70;"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            />
          </svg>
        </div>
        <h3
          class="text-2xl font-serif font-semibold mb-4"
          style="color: #1a2e1e;"
        >
          State-of-the-Art Infrastructure
        </h3>
        <p class="max-w-2xl mx-auto text-lg mb-3" style="color: #5a7060;">
          Detailed information about Fox Chase Farm's equipment, CEA labs, technology systems,
          and innovative infrastructure is coming soon.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const container = document.getElementById("video-container");
  const overlay = document.getElementById("video-overlay");

  if (video && container && overlay) {
    const showOverlay = () => {
      overlay.style.opacity = "1";
      overlay.style.pointerEvents = "auto";
    };
    const hideOverlay = () => {
      overlay.style.opacity = "0";
      overlay.style.pointerEvents = "none";
    };

    // Pause and show overlay when scrolled out of view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            video.pause();
            showOverlay();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(container);

    // Play on hover
    container.addEventListener("mouseenter", () => {
      video.play().catch(() => {});
      hideOverlay();
    });

    // Pause when mouse leaves
    container.addEventListener("mouseleave", () => {
      video.pause();
      showOverlay();
    });
  }
</script>
