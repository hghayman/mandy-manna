---
import Base from "@/layouts/Base.astro";
import { Image, type ImageMetadata } from "astro:assets";

import imgOnFarm from "@/assets/images/programs/on-farm-learning.jpg";
import imgAnimalScience from "@/assets/images/programs/animal-science.jpg";
import imgBirdhouse from "@/assets/images/programs/birdhouse-workshop.jpg";
import imgEmpowerment from "@/assets/images/programs/ag-empowerment.jpg";
import imgEnterprise from "@/assets/images/programs/student-enterprises.jpg";
import imgEnterprise2 from "@/assets/images/programs/student-enterprises-2.jpg";
import imgAcademy from "@/assets/images/programs/agriculture-innovations-academy.jpg";
import imgAmbassadors from "@/assets/images/programs/ambassadors.jpg";
