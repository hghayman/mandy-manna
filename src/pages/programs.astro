    bg: "background-color: #f0f4f1;",
    badge: "background-color: #e8f0eb; color: #2d5a3d;",
    iconBg: "background-color: #2d5a3d;",
  },
  teal: {
    bg: "background-color: #ffffff;",
    badge: "background-color: #e0f0ee; color: #1f5c57;",
    iconBg: "background-color: #2d6b65;",
  },
  emerald: {
    bg: "background-color: #f0f4f1;",
    badge: "background-color: #e8f0eb; color: #1f5c3a;",
    iconBg: "background-color: #3a7a5a;",
