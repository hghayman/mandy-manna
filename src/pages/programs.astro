---

<Base
  title="Programs - Fox Chase Farm"
  meta_title="Programs - Dr. Mandy Manna & Fox Chase Farm"
  description="Explore agricultural education, workforce development, and community programs at Fox Chase Farm, serving 62K+ students annually across 60 Philadelphia schools."
>
  <!-- Page Header -->
  <section class="pt-20 pb-12 text-center" style="background-color: #fafaf8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span
        class="inline-block text-xs font-semibold tracking-widest uppercase mb-4 px-3 py-1.5 rounded-full"
        style="background-color: #e8f0eb; color: #2d5a3d;"
      >
        Fox Chase Farm
      </span>
      <h1
        class="text-4xl lg:text-5xl font-serif font-semibold mb-5 leading-tight"
        style="color: #1a2e1e;"
      >
        Programs at Fox Chase Farm
      </h1>
      <p class="text-lg max-w-2xl mx-auto mb-8" style="color: #5a7060;">
        Agricultural education, workforce development, and community engagement
        serving 62K+ students across Philadelphia every year.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="#education"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Education
        </a>
        <a
          href="#workforce"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Workforce Development
        </a>
        <a
          href="#community"
          class="px-5 py-2 rounded-full text-sm font-semibold transition-colors"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          Community
        </a>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section id="video-section" class="py-12" style="background-color: #f0f4f1;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span
          class="inline-block text-xs font-semibold tracking-widest uppercase mb-3 px-3 py-1.5 rounded-full"
          style="background-color: #e8f0eb; color: #2d5a3d;"
        >
          In Action
        </span>
        <h2 class="text-3xl lg:text-4xl font-serif font-semibold" style="color: #1a2e1e;">
          See the Programs in Action
        </h2>
      </div>

      <div
        id="video-container"
        class="relative rounded-2xl overflow-hidden shadow-xl"
        style="background-color: #0d1f13;"
      >
        <video
          id="hero-video"
          loop
          playsinline
          preload="none"
          class="w-full block"
          style="max-height: 480px;"
          poster="/images/video-poster.jpg"
        >
          <source src="/videos/cte-programs-trimmed.mp4" type="video/mp4" />
        </video>

        <!-- Minimal controls — always visible at bottom -->
        <div
          id="video-controls"
          class="absolute bottom-0 left-0 right-0 px-5 pb-4 pt-10"
          style="background: linear-gradient(to top, rgba(10,24,14,0.85) 0%, transparent 100%);"
        >
          <!-- Progress bar -->
          <div
            id="progress-track"
            class="w-full rounded-full mb-4 cursor-pointer"
            style="height: 3px; background: rgba(255,255,255,0.2);"
          >
            <div
              id="progress-fill"
              class="h-full rounded-full"
              style="width: 0%; background: #a8c5a0; transition: none;"
            >
            </div>
          </div>

          <!-- Buttons row -->
          <div class="flex items-center gap-5">
            <!-- Seek back 10s -->
            <button
              id="seek-back"
              class="flex items-center gap-1 transition-opacity"
              style="color: rgba(255,255,255,0.75);"
              title="Back 10 seconds"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z"
                ></path>
              </svg>
              <span
                class="text-xs font-medium"
                style="color: rgba(255,255,255,0.6);">10</span
              >
            </button>

            <!-- Mute toggle -->
            <button
              id="mute-btn"
              class="transition-opacity"
              style="color: rgba(255,255,255,0.75);"
              title="Toggle audio"
            >
              <!-- Muted icon (hidden by default — audio is on) -->
              <svg
                id="icon-muted"
                class="w-5 h-5 hidden"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
              </svg>
              <!-- Unmuted icon (shown by default) -->
              <svg
                id="icon-unmuted"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-9.536A5 5 0 008 12a5 5 0 00.464 2.536M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                ></path>
              </svg>
            </button>

            <!-- Seek forward 10s -->
            <button
              id="seek-fwd"
              class="flex items-center gap-1 transition-opacity"
              style="color: rgba(255,255,255,0.75);"
              title="Forward 10 seconds"
            >
              <span
                class="text-xs font-medium"
                style="color: rgba(255,255,255,0.6);">10</span
              >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11.933 12.8a1 1 0 000-1.6L6.6 7.2A1 1 0 005 8v8a1 1 0 001.6.8l5.333-4zM19.933 12.8a1 1 0 000-1.6l-5.333-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.333-4z"
                ></path>
              </svg>
            </button>

            <!-- Auto-play status pill -->
            <span
              id="play-status"
              class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full"
              style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.45);"
            >
              Scroll into view to play
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section style="background-color: #fafaf8; border-bottom: 1px solid #dde8de;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
