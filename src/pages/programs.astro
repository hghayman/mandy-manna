<script>
  const video = document.getElementById(
    "hero-video",
  ) as HTMLVideoElement | null;
  const section = document.getElementById(
    "video-section",
  ) as HTMLElement | null;
  const fill = document.getElementById("progress-fill") as HTMLElement | null;
  const track = document.getElementById("progress-track") as HTMLElement | null;
  const muteBtn = document.getElementById("mute-btn");
  const seekBack = document.getElementById("seek-back");
  const seekFwd = document.getElementById("seek-fwd");
  const status = document.getElementById("play-status");
  const iconMuted = document.getElementById("icon-muted");
  const iconUnmuted = document.getElementById("icon-unmuted");

  if (video && section) {
    // Autoplay stays muted (browser policy + no surprise audio). Users unmute via the audio button.
    video.muted = true;
    if (iconMuted) iconMuted.classList.remove("hidden");
    if (iconUnmuted) iconUnmuted.classList.add("hidden");

    // --- Auto-play / pause based on section visibility ---
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            video
              .play()
              .then(() => {})
              .catch(() => {});
            if (status) status.textContent = "Playing";
          } else {
            video.pause();
            if (status) status.textContent = "Scroll into view to play";
          }
        });
      },
      { threshold: 0.5 },
    );
    observer.observe(section);

    // --- Progress bar ---
    if (fill) {
      video.addEventListener("timeupdate", () => {
        if (video.duration) {
          fill.style.width = `${(video.currentTime / video.duration) * 100}%`;
        }
      });
    }

    // --- Seek by clicking the progress track ---
    if (track) {
      track.addEventListener("click", (e) => {
        const rect = track.getBoundingClientRect();
        const ratio = Math.max(
          0,
          Math.min(1, (e.clientX - rect.left) / rect.width),
        );
        video.currentTime = ratio * video.duration;
      });
    }

    // --- Mute toggle ---
    if (muteBtn && iconMuted && iconUnmuted) {
      muteBtn.addEventListener("click", () => {
        video.muted = !video.muted;
        iconMuted.classList.toggle("hidden", !video.muted);
        iconUnmuted.classList.toggle("hidden", video.muted);
      });
    }

    // --- Seek buttons ---
    seekBack?.addEventListener("click", () => {
      video.currentTime = Math.max(0, video.currentTime - 10);
    });
    seekFwd?.addEventListener("click", () => {
      video.currentTime = Math.min(video.duration, video.currentTime + 10);
    });
  } // end if (video && section)
</script>
