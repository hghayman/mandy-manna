    color: "green",
    description:
      "Hands-on agricultural learning from kindergarten through 12th grade, connecting classrooms to the real world of the farm.",
    programs: [
      {
        title: "On-Farm Learning Experiences",
        description:
          "Hands-on agricultural programming for K-12 students across the School District of Philadelphia, connecting classroom learning to real-world farm systems.",
