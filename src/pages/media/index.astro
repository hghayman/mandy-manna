---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const BLOG_FOLDER = "blog";

const postIndex = (await getEntry(
  BLOG_FOLDER,
  "-index",
)) as CollectionEntry<"blog">;
const posts = await getSinglePage(BLOG_FOLDER);
const sortedPosts = sortByDate(posts);

const pressPlaceholders = [
  {
    title: "Press Coverage Coming Soon",
    source: "Media",
    description: "Featured articles, interviews, and press coverage of Dr. Mandy Manna's work will appear here. Check back soon.",
    link: "",
    date: "",
    placeholder: true,
  },
];

const mediaEntries = sortedPosts.length > 0 ? sortedPosts : [];
---

<Base
  title={postIndex.data.title}
  meta_title={postIndex.data.meta_title}
  description={postIndex.data.description}
>
  <PageHeader title={postIndex?.data.title} />

  <section class="py-16" style="background-color: #fafaf8;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <p class="text-center text-lg leading-relaxed mb-12 max-w-2xl mx-auto" style="color: #5a7060;">
        Press features, articles, interviews, and media coverage of Dr. Mandy Manna's
        work in agricultural education and innovation.
      </p>

      {mediaEntries.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {mediaEntries.map((post) => (
            <a
              href={`/media/${post.id}`}
              class="group bg-white rounded-xl overflow-hidden flex flex-col transition-all duration-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4a7c59] focus-visible:ring-offset-2"
              style="border: 1px solid #dde8de;"
            >
              {post.data.image && (
                <div class="flex justify-center items-center px-4 h-44 overflow-hidden" style="background-color: #f4f7f4;">
                  <img
                    src={typeof post.data.image === 'string' ? post.data.image : post.data.image?.src}
                    alt={post.data.heroAlt ?? post.data.title}
                    class="max-h-40 w-auto block rounded-lg"
                    style="object-fit: contain;"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span
                    class="px-3 py-1 text-xs font-semibold rounded-full"
                    style="background-color: #e8f0eb; color: #2d5a3d;"
                  >
                    {post.data.category ?? "Feature"}
                  </span>
                  {post.data.pubDate && (
                    <span class="text-xs" style="color: #5a7060;">
                      {new Date(post.data.pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
                    </span>
                  )}
                </div>
                <h2 class="text-lg font-semibold mb-2 leading-snug" style="color: #1a2e1e;">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-base leading-relaxed flex-1 mb-4" style="color: #4f6357;">
                    {post.data.description}
                  </p>
                )}
                <span
                  class="inline-flex items-center gap-1.5 text-sm font-semibold transition-all mt-auto group-hover:gap-2.5"
                  style="color: #2d5a3d;"
                >
                  Read more
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pressPlaceholders.map((entry) => (
            <article
              class="bg-white rounded-xl overflow-hidden flex flex-col"
              style="border: 2px dashed #dde8de;"
            >
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span
                    class="px-3 py-1 text-xs font-semibold rounded-full"
                    style="background-color: #f0f4f1; color: #4f6357;"
                  >
                    {entry.source}
                  </span>
                </div>
                <h2 class="text-base font-semibold mb-2 leading-snug" style="color: #3a5040;">
                  {entry.title}
                </h2>
                <p class="text-base leading-relaxed flex-1" style="color: #5a7060;">
                  {entry.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      )}

      <!-- Media Inquiry CTA -->
      <div class="mt-16 text-center">
        <div
          class="inline-block bg-white rounded-2xl p-8 max-w-xl"
          style="border: 1px solid #dde8de; box-shadow: 0 4px 24px -8px rgba(45,90,61,0.08);"
        >
          <span class="inline-block text-xs font-semibold tracking-widest uppercase mb-3" style="color: #4a7c59;">Press</span>
          <h3 class="text-xl font-serif font-semibold mb-2" style="color: #1a2e1e;">Media Inquiries</h3>
          <p class="text-sm mb-5" style="color: #5a7060;">
            For press inquiries, interviews, or speaking requests, please reach out directly.
          </p>
          <a
            href="/consult"
            class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-lg transition-colors duration-200 text-sm"
            style="background-color: #1a3325;"
          >
            Get in Touch
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
