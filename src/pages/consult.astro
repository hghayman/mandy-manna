---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry } from "astro:content";

const contactEntry = await getEntry("contact", "-index");

if (!contactEntry) {
  throw new Error("Consulting page content could not be loaded.");
}

const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactEntry.data;

const services = [
  {
    title: "Program Design",
    description:
      "Align agricultural innovation programs with district priorities, strategic plans, and community needs.",
  },
  {
    title: "Workforce Pipelines",
    description:
      "Develop CEA, trades, and ag-tech pathways connecting students from elementary through high school.",
  },
  {
    title: "Funding and Sustainability",
    description:
      "Secure competitive grants and build multi-year roadmaps that sustain growth and long-term impact.",
  },
  {
    title: "Educator Development",
    description:
      "Train and certify teachers in agricultural literacy with hands-on, standards-aligned learning.",
  },
  {
    title: "Community Engagement",
    description:
      "Engage communities through events, partnerships, and student-run enterprises advancing food justice.",
  },
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />

  <section class="py-16" style="background-color: #fafaf8;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Consulting Services panel -->
        <div class="lg:col-span-1">
          <div
            class="rounded-2xl p-8 h-full"
            style="background-color: #1a3325;"
          >
            <span
              class="inline-block text-xs font-semibold tracking-widest uppercase mb-4 px-3 py-1.5 rounded-full"
              style="background-color: rgba(255,255,255,0.1); color: #a8c5a0;"
            >
              Consulting Services
            </span>
            <h2 class="text-2xl font-serif font-semibold text-white mb-3">
              Strategic Agricultural Innovation
            </h2>
            <p class="text-sm leading-relaxed mb-8" style="color: #c4d8c0;">
              Dr. Manna partners with districts, agencies, and organizations to build sustainable, student-centered agriculture ecosystems.
            </p>
            <div class="space-y-3">
              {services.map((service) => (
                <div
                  class="rounded-xl p-4"
                  style="background-color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);"
                >
                  <h3 class="text-sm font-semibold text-white mb-1">{service.title}</h3>
                  <p class="text-xs leading-relaxed" style="color: #a8c5a0;">{service.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div
            class="bg-white rounded-2xl p-8"
            style="border: 1px solid #dde8de; box-shadow: 0 4px 24px -8px rgba(45,90,61,0.1);"
          >
            <span class="inline-block text-xs font-semibold tracking-widest uppercase mb-3" style="color: #4a7c59;">
              Get in Touch
            </span>
            <h2 class="text-3xl font-serif font-semibold mb-2" style="color: #1a2e1e;">
              Send a Message
            </h2>
            <p class="text-base leading-relaxed mb-8" style="color: #5a7060;">
              Share your goals and we will connect to design a consulting partnership tailored to your district or organization.
            </p>
            <form action={contact_form_action} method="POST" class="space-y-5">
              <div>
                <label for="name" class="block text-sm font-semibold mb-2" style="color: #1a2e1e;">
                  Full Name <span style="color: #c0392b;">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  class="w-full px-4 py-3 rounded-lg text-sm transition-colors duration-200 outline-none"
                  style="border: 1px solid #dde8de; background-color: #fafaf8; color: #1a2e1e;"
                  placeholder="Your Name"
                  type="text"
                  required
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold mb-2" style="color: #1a2e1e;">
                  Email Address <span style="color: #c0392b;">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  class="w-full px-4 py-3 rounded-lg text-sm transition-colors duration-200 outline-none"
                  style="border: 1px solid #dde8de; background-color: #fafaf8; color: #1a2e1e;"
                  placeholder="your.email@example.com"
                  type="email"
                  required
                />
              </div>
              <div>
                <label for="subject" class="block text-sm font-semibold mb-2" style="color: #1a2e1e;">
                  Subject
                </label>
                <input
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-lg text-sm transition-colors duration-200 outline-none"
                  style="border: 1px solid #dde8de; background-color: #fafaf8; color: #1a2e1e;"
                  placeholder="How can Dr. Manna help?"
                  type="text"
                />
              </div>
              <div>
                <label for="message" class="block text-sm font-semibold mb-2" style="color: #1a2e1e;">
                  Message <span style="color: #c0392b;">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  class="w-full px-4 py-3 rounded-lg text-sm transition-colors duration-200 outline-none resize-none"
                  style="border: 1px solid #dde8de; background-color: #fafaf8; color: #1a2e1e;"
                  placeholder="Tell us about your district, your goals, and how we can partner together..."
                  rows="7"
                  required></textarea>
              </div>
              <button
                type="submit"
                class="w-full py-3.5 text-white font-semibold rounded-lg transition-colors duration-200 text-sm"
                style="background-color: #1a3325;"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Bottom info row -->
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <div
          class="bg-white rounded-2xl p-6"
          style="border: 1px solid #dde8de;"
        >
          <h3 class="text-lg font-serif font-semibold mb-4" style="color: #1a2e1e;">Location</h3>
          <div class="space-y-2 text-sm" style="color: #5a7060;">
            <p class="font-medium" style="color: #3a5040;">Fox Chase Farm</p>
            <p>School District of Philadelphia</p>
            <p>Philadelphia, PA</p>
          </div>
        </div>

        <div
          class="bg-white rounded-2xl p-6"
          style="border: 1px solid #dde8de;"
        >
          <h3 class="text-lg font-serif font-semibold mb-4" style="color: #1a2e1e;">Connect</h3>
          <div class="flex flex-wrap gap-2">
            <a
              href="https://www.linkedin.com/in/drmandy"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200"
              style="border: 1px solid #dde8de; color: #2d5a3d; background-color: #f6f9f6;"
            >
              LinkedIn
            </a>
            <a
              href="https://www.facebook.com/TheFoxChaseFarm"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200"
              style="border: 1px solid #dde8de; color: #2d5a3d; background-color: #f6f9f6;"
            >
              Facebook
            </a>
            <a
              href="https://www.instagram.com/farmgirlgo"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200"
              style="border: 1px solid #dde8de; color: #2d5a3d; background-color: #f6f9f6;"
            >
              Instagram
            </a>
            <a
              href="mailto:contact@drmandy.com"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200"
              style="border: 1px solid #dde8de; color: #2d5a3d; background-color: #f6f9f6;"
            >
              Email
            </a>
          </div>
          <p class="text-xs mt-4" style="color: #8a9e8e;">
            Responses within 48 hours during the school year.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
